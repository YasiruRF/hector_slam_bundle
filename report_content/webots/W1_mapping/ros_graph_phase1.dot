digraph G {
  rankdir=LR; splines=true; nodesep=0.25; ranksep=0.9;
  node [fontname="Helvetica", fontsize=11];
  "/hector_mapping" [shape=ellipse, style=filled, fillcolor="#cfe3ff"];
  "/hector_trajectory_server" [shape=ellipse, style=filled, fillcolor="#cfe3ff"];
  "/pose_logger" [shape=ellipse, style=filled, fillcolor="#cfe3ff"];
  "/run_logger" [shape=ellipse, style=filled, fillcolor="#cfe3ff"];
  "/rviz2" [shape=ellipse, style=filled, fillcolor="#cfe3ff"];
  "/tb4_webots_bridge" [shape=ellipse, style=filled, fillcolor="#cfe3ff"];
  "T/ground_truth/pose" [label="/ground_truth/pose", shape=box, style=filled, fillcolor="#fff2c6"];
  "/tb4_webots_bridge" -> "T/ground_truth/pose";
  "T/ground_truth/pose" -> "/pose_logger";
  "T/ground_truth/pose" -> "/run_logger";
  "T/initialpose" [label="/initialpose", shape=box, style=filled, fillcolor="#fff2c6"];
  "/rviz2" -> "T/initialpose";
  "T/initialpose" -> "/hector_mapping";
  "T/map" [label="/map", shape=box, style=filled, fillcolor="#fff2c6"];
  "/hector_mapping" -> "T/map";
  "T/map" -> "/run_logger";
  "T/map" -> "/rviz2";
  "T/scan" [label="/scan", shape=box, style=filled, fillcolor="#fff2c6"];
  "/tb4_webots_bridge" -> "T/scan";
  "T/scan" -> "/hector_mapping";
  "T/scan" -> "/run_logger";
  "T/scan" -> "/rviz2";
  "T/slam_out_pose" [label="/slam_out_pose", shape=box, style=filled, fillcolor="#fff2c6"];
  "/hector_mapping" -> "T/slam_out_pose";
  "T/slam_out_pose" -> "/run_logger";
  "T/tf" [label="/tf", shape=box, style=filled, fillcolor="#fff2c6"];
  "/hector_mapping" -> "T/tf";
  "/tb4_webots_bridge" -> "T/tf";
  "T/tf" -> "/pose_logger";
  "T/tf" -> "/run_logger";
  "T/tf_static" [label="/tf_static", shape=box, style=filled, fillcolor="#fff2c6"];
  "/tb4_webots_bridge" -> "T/tf_static";
  "T/tf_static" -> "/pose_logger";
  "T/tf_static" -> "/run_logger";
  "T/trajectory" [label="/trajectory", shape=box, style=filled, fillcolor="#fff2c6"];
  "/hector_trajectory_server" -> "T/trajectory";
  "T/trajectory" -> "/rviz2";
}
